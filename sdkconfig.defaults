CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384
CONFIG_PARTITION_TABLE_OFFSET=0x10000

# 1 kHz tick so the DWM poll loops' delay_ms(1) is a real 1ms yielding delay.
# at the default 100 Hz, pdMS_TO_TICKS(1) rounds to 0 -> vTaskDelay(0) never
# yields -> the status-poll loop starves the idle task -> task watchdog reset.
CONFIG_FREERTOS_HZ=1000
