# Written with Claude

# clangd runs inside the dev container (see scripts/clangd.sh) and reads the
# ESP-IDF compile_commands.json. Those commands carry xtensa-gcc codegen flags
# that clangd's embedded clang rejects outright -- strip them so parsing works.
# Non-test files use clangd's auto-discovered root build/ DB.
CompileFlags:
  Remove:
    - -mlongcalls
    - -fstrict-volatile-bitfields
    - -fno-tree-switch-conversion
    - -fno-shrink-wrap

---
# Test sources exist only in the test project's build DB, not the root app build
# that clangd auto-discovers -- so point them at the device test build (produced
# by `test/run.sh device`), which carries their real include paths.
If:
  PathMatch: ".*test/.*"
CompileFlags:
  CompilationDatabase: test/build_device

---
# Header-only components register with `SRCS ""`, so they contribute no entry to
# compile_commands.json and clangd infers a command from whatever nearby TU it
# picks. That TU carries only its own component's REQUIRES -- and may be a C
# source, which parses these as C -- so pin the sibling include dirs and the
# language rather than leaving both to the guess
If:
  PathMatch: 'components/(dwm|l298n|swarm_consumer|swarm_hal|swarm_queue)/.*\.h'
CompileFlags:
  Remove:
    - -std=gnu17
  Add:
    - -xc++
    - -std=gnu++23
    - -I/workspace/components/swarm_hal
    - -I/workspace/components/swarm_queue
    - -I/workspace/components/swarm_consumer
    - -I/workspace/components/dwm
    - -I/workspace/components/l298n
    - -I/workspace/components/esp32/include
