# clangd config for the swarm project.
#
# clangd runs INSIDE the dev container (see scripts/clangd.sh), so it reads the
# native ESP-IDF v5.5 headers and queries the xtensa cross-gcc (via the wrapper's
# --query-driver) for the target and system include paths. We therefore do NOT
# hand-roll toolchain/sysroot flags here -- only strip the handful of gcc-only
# codegen flags clang's parser rejects, and route each file to the right
# compile_commands.json.

CompileFlags:
  # gcc-specific flags clang doesn't understand; harmless to drop for parsing.
  Remove:
    - -mlongcalls
    - -fstrict-volatile-bitfields
    - -fno-tree-switch-conversion
    - -fno-shrink-wrap
  CompilationDatabase: build

---
If:
  PathMatch: ".*/test/.*"
CompileFlags:
  CompilationDatabase: test/build

---
# dwm is a header-only component: no translation unit compiles its headers, so
# clangd otherwise guesses a far-away C command as the proxy (c-header language,
# wrong includes). Pin it to the test build DB -- reg_view.cpp sits next to the
# headers and includes them -- and force C++ so the header-only templates parse.
# NOTE: PathMatch is evaluated against the path relative to this .clangd file, so
# there's no leading slash before "components".
If:
  PathMatch: ".*components/dwm/.*"
CompileFlags:
  CompilationDatabase: test/build
  Add: [-xc++]
