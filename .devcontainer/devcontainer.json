{
  "name": "micro-ROS Dev",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "workspaceFolder": "/workspace",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind",
  "containerEnv": {
    "LC_ALL": "C.UTF-8",
    "LANG": "C.UTF-8"
  },
  "postCreateCommand": "bash -lc 'scripts/microros-pin.sh seed'",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools"
      ]
    }
  }
}
